# Default behavior: auto-normalize text files to LF
* text=auto eol=lf

# Force LF line endings for shell scripts and container files
*.sh text eol=lf
Dockerfile text eol=lf
*.cfg text eol=lf
*.data text eol=lf
*.names text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.list text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Force CRLF line endings for Windows batch scripts
*.bat text eol=crlf

# Explicit binary files
*.png binary
*.PNG binary
*.jpg binary
*.JPG binary
*.jpeg binary
*.gif binary
*.weights binary
*.dll binary
*.exe binary
*.lib binary
*.exp binary
darknet binary

